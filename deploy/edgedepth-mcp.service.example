[Unit]
Description=EdgeDepth Research MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edgedepth-web
Group=edgedepth-web
WorkingDirectory=/opt/edgedepth-mcp/current
EnvironmentFile=/etc/edgedepth-mcp.env
Environment=NODE_ENV=production
Environment=PORT=3003
Environment=HOST=127.0.0.1
ExecStart=/opt/node-v22/bin/node dist/http.js
Restart=always
RestartSec=3
Nice=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/edgedepth-mcp

[Install]
WantedBy=multi-user.target
